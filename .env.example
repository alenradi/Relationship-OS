# =============================================================================
# Us — environment variables
#
# 1. Create a NEW Supabase project (do not reuse an existing one).
# 2. Copy this file to .env.local and fill in the values from
#    Project Settings → API.
# 3. Run the SQL migrations in supabase/migrations/ in order (0001 → 0012)
#    via the Supabase SQL editor, or `supabase db push` if you use the CLI.
# 4. Run `npm run seed` once to create the two demo accounts + sample data.
# =============================================================================

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Web Push (home-screen notifications). Generate with:
# npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
CRON_SECRET=
